	partition 'Geral_Conferencia' = m
		mode: import
		source =
				let
				    App=Table.Buffer(Table.FromRecords(Json.Document(Binary.FromText("",BinaryEncoding.Base64)))),
				    IDs=Table.Buffer(Table.FromRecords(Json.Document(Binary.FromText("",BinaryEncoding.Base64)))),
				    Unidades=Table.Buffer(Table.FromRecords(Json.Document(Binary.FromText("",BinaryEncoding.Base64)))),
				    Planos=Table.Buffer(Table.FromRecords(Json.Document(Binary.FromText("",BinaryEncoding.Base64)))),
				    Existentes=Table.Buffer(Table.FromRecords(Json.Document(Binary.FromText("",BinaryEncoding.Base64)))),
				    FonteSQL=Sql.Database("SRVSEDE01621PRE","CorporeRM",[Query="WITH T AS (#(lf)SELECT * FROM dbo.STURMA WHERE CODCOLIGADA=3  AND DTFINAL>=CONVERT(date,'20270101',112)#(lf)), X AS (#(lf)SELECT C.CODCOLIGADA,C.CODFILIAL,C.IDPERLET,C.CODTURMA,COUNT(*) N,#(lf)CASE WHEN COUNT(*)=1 THEN MAX(CONVERT(nvarchar(100),C.CLASSIFICACAO)) END Classificacao,#(lf)CASE WHEN COUNT(*)=1 THEN MAX(CONVERT(nvarchar(100),C.MOBILIZACAO)) END Mobilizacao#(lf)FROM dbo.STURMACOMPL C INNER JOIN T ON T.CODCOLIGADA=C.CODCOLIGADA AND T.CODFILIAL=C.CODFILIAL AND T.IDPERLET=C.IDPERLET AND T.CODTURMA=C.CODTURMA#(lf)GROUP BY C.CODCOLIGADA,C.CODFILIAL,C.IDPERLET,C.CODTURMA#(lf)), MOB AS (#(lf)SELECT CONVERT(nvarchar(100),CODCLIENTE) Codigo,COUNT(*) N,#(lf)CASE WHEN COUNT(*)=1 THEN MAX(CONVERT(nvarchar(4000),DESCRICAO)) END Descricao#(lf)FROM dbo.GCONSIST WHERE CODCOLIGADA=3 AND APLICACAO='S' AND CODTABELA='POMOBILIZA'#(lf)GROUP BY CONVERT(nvarchar(100),CODCLIENTE)#(lf))#(lf)SELECT T.CODCOLIGADA,T.CODFILIAL,T.IDPERLET,T.IDFT,CONVERT(nvarchar(100),T.CODTURMA) Codigo_Turma,#(lf)CONVERT(nvarchar(4000),F.NOME) Nome_Unidade_RM,CONVERT(nvarchar(100),H.CODCURSO) Codigo_Curso,CONVERT(nvarchar(100),H.CODHABILITACAO) Codigo_Habilitacao,#(lf)CONVERT(nvarchar(100),H.CODGRADE) Codigo_Matriz,#(lf)CONVERT(nvarchar(100),P.CODPERLET) Periodo_Letivo,T.DTINICIAL Data_Inicio,T.DTFINAL Data_Fim,T.MAXALUNOS Vagas,#(lf)CONVERT(nvarchar(100),T.CODCAMPUS) Codigo_Campus,CONVERT(nvarchar(100),T.TIPOMEDIACAO) Codigo_Mediacao,#(lf)X.N Ocorrencias_Complemento,X.Classificacao,X.Mobilizacao Codigo_Mobilizacao,MOB.N Ocorrencias_Mobilizacao,MOB.Descricao Descricao_Mobilizacao#(lf)FROM T LEFT JOIN dbo.GFILIAL F ON F.CODCOLIGADA=T.CODCOLIGADA AND F.CODFILIAL=T.CODFILIAL#(lf)LEFT JOIN dbo.SHABILITACAOFILIAL H ON H.CODCOLIGADA=T.CODCOLIGADA AND H.IDHABILITACAOFILIAL=T.IDHABILITACAOFILIAL#(lf)LEFT JOIN dbo.SPLETIVO P ON P.CODCOLIGADA=T.CODCOLIGADA AND P.IDPERLET=T.IDPERLET#(lf)LEFT JOIN X ON X.CODCOLIGADA=T.CODCOLIGADA AND X.CODFILIAL=T.CODFILIAL AND X.IDPERLET=T.IDPERLET AND X.CODTURMA=T.CODTURMA#(lf)LEFT JOIN MOB ON MOB.Codigo=X.Mobilizacao#(lf)ORDER BY T.CODTURMA;"]),
				    Fonte=Table.Buffer(FonteSQL),
				    Chave=(Valores as list) as text=>Text.FromBinary(Json.FromValue(Valores),TextEncoding.Utf8),
				    Indexar=(T as table,Campos as list) as record=>let K=Table.AddColumn(T,"__indice",each let R=_ in Chave(List.Transform(Campos,(C)=>Record.Field(R,C))),type text),G=Table.Group(K,{"__indice"},{{"Linhas",each Table.Buffer(Table.RemoveColumns(_,{"__indice"})),type table}}),B=Table.Buffer(G) in Record.FromList(B[Linhas],B[__indice]),
				    IApp=Indexar(App,{"Codigo_Matriz"}),
				    IUnidades=Indexar(Table.SelectRows(Unidades,each [Ativa]="True"),{"Codigo_Filial"}),
				    IPlanos=Indexar(Table.SelectRows(Planos,each [Ativo]="True"),{"Nome_Planejamento","Unidade"}),
				    IExistentes=Indexar(Existentes,{"Unidade","Codigo_Turma_SGE"}),
				    ISementes=Indexar(IDs,{"Codigo"}),
				    Contagem=Table.Group(Fonte,{"CODCOLIGADA","CODFILIAL","IDPERLET","Codigo_Turma"},{{"N",each Table.RowCount(_),Int64.Type}}),
				    Captura=Date.ToText(Date.From(DateTime.FixedLocalNow()),"dd/MM/yyyy","pt-BR"),
				    IContagem=Indexar(Contagem,{"CODCOLIGADA","CODFILIAL","IDPERLET","Codigo_Turma"}),
				    Gerar=Table.AddColumn(Fonte,"Gerado",each let R=_,U=Record.FieldOrDefault(IUnidades,Chave({Text.From(R[CODFILIAL])}),Table.FirstN(Unidades,0)),Un=if Table.RowCount(U)=1 then U{0}[Nome_Unidade] else null,Sigla=if Table.RowCount(U)=1 then U{0}[Sigla_UNOP] else null,Plano=if Un=null then null else "Planejamento " & Un,P=if Plano=null then Table.FirstN(Planos,0) else Record.FieldOrDefault(IPlanos,Chave({Plano,Un}),Table.FirstN(Planos,0)),E=if Un=null then Table.FirstN(Existentes,0) else Record.FieldOrDefault(IExistentes,Chave({Un,R[Codigo_Turma]}),Table.FirstN(Existentes,0)),A=Record.FieldOrDefault(IApp,Chave({R[Codigo_Matriz]}),Table.FirstN(App,0)),S=Record.FieldOrDefault(ISementes,Chave({R[Codigo_Turma]}),Table.FirstN(IDs,0)),N=Record.Field(IContagem,Chave({R[CODCOLIGADA],R[CODFILIAL],R[IDPERLET],R[Codigo_Turma]})){0}[N],M=if Table.RowCount(A)=1 and A{0}[Ativa]=true then A{0} else null,Ident=if Table.RowCount(E)=1 and E{0}[Identificador_Temporario]<>"" then E{0}[Identificador_Temporario] else if Table.RowCount(S)=1 and R[CODFILIAL]=266 then S{0}[Identificador] else if Sigla=null or Sigla="" or R[IDFT]=null then null else Sigla & "-" & DateTime.ToText(#datetime(2026,10,19,0,0,0)+#duration(0,0,0,Number.From(R[IDFT])),"yyyyMMddHHmmss","pt-BR"),Med=if [Codigo_Mediacao]="1" then "Presencial" else if [Codigo_Mediacao]="2" then "Semipresencial" else if [Codigo_Mediacao]="3" then "À distância" else null,Fin=if [Classificacao]="1" then "Gratuidade" else if [Classificacao]="2" then "Negócio" else if [Classificacao]="3" then "Negócio PJ" else null,Campus=Record.FieldOrDefault([#"1"="Matriz da Escola - Senai",#"2"="Unidades Móveis - Senai",#"3"="Agência / Extensão - Senai",#"4"="Unidades Remotas - Senai",#"5"="Ambiente da Empresa - Senai"],if [Codigo_Campus]=null then "" else [Codigo_Campus],null),Dt=(V as any)=>if V=null then null else Date.ToText(Date.From(V),"dd/MM/yyyy","pt-BR"),Falhas=List.RemoveNulls({if Un=null then "Unidade sem Codigo_Filial numérico correspondente no cadastro local" else null,if Table.RowCount(P)<>1 then "Planejamento esperado ausente ou ambíguo: " & (if Plano=null then "unidade não identificada" else Plano) else null,if N<>1 then "Chave de turma duplicada no resultado RM" else null,if M=null then "Matriz ausente, duplicada ou inativa no cadastro local" else null,if Ident=null or Ident="" then "Identificador não localizado" else null,if [Data_Inicio]=null then "Data de início vazia" else null,if [Periodo_Letivo]=null then "Período letivo vazio" else null,if [Vagas]=null or [Vagas]<=0 then "Vagas não válidas" else null,if Med=null then "Mediação não traduzida" else null,if Fin=null then "Financiamento vazio ou não traduzido" else null,if [Ocorrencias_Complemento]<>null and [Ocorrencias_Complemento]<>1 then "Complemento da turma ambíguo" else null,if [Codigo_Mobilizacao]<>null and Text.Trim([Codigo_Mobilizacao])<>"" and [Descricao_Mobilizacao]=null then "Mobilização sem descrição única no RM" else null,if M<>null then (if M[Modalidade]="" or M[Carga_Horaria]=null then "Cadastro de matriz incompleto" else null) else null}),Dados=[Planejamento=Plano,Unidade=Un,Periodo_Letivo=[Periodo_Letivo],Ano_Referencia=if [Data_Inicio]=null then null else Number.ToText(Date.Year(Date.From([Data_Inicio])),"N0","pt-BR"),Identificador_Temporario=Ident,Codigo_Turma_SGE=[Codigo_Turma],Matriz=if M=null then null else M[Codigo_Matriz],Status_Turma="Rascunho",Ativa="Sim",Codigo_Matriz_Snapshot=if M=null then null else M[Codigo_Matriz],Nome_Curso_Snapshot=if M=null then null else M[Nome_Curso],Area_Snapshot=if M=null then null else M[Area],Modalidade_Snapshot=if M=null then null else M[Modalidade],Tipo_Mediacao_Snapshot=if M=null then null else M[Tipo_Mediacao],Carga_Horaria_Snapshot=if M=null then null else if M[Carga_Horaria]=null then null else Number.ToText(M[Carga_Horaria],"F2","pt-BR"),Data_Snapshot_Matriz=if M=null then null else Captura,Data_Inicio_Prevista=Dt([Data_Inicio]),Data_Fim_Prevista=Dt([Data_Fim]),Quantidade_Vagas=[Vagas],Matriculas_Previstas=[Vagas],Campus_Polo=Campus,Financiamento=Fin,Mobilizacao=[Descricao_Mobilizacao],Bloqueada_Para_Edicao="Não",Versao_Planejamento=1,Origem_Registro="Importação",Codigo_Matriz_Excel=if M=null then null else M[Codigo_Matriz],Modalidade=Med,Pendencias_Carga=Text.Combine(Falhas,"; "),Situacao_Carga=if Table.RowCount(E)>0 then "Já existente na lista enviada" else if List.Count(Falhas)=0 then "Candidata; validar opções antes da inclusão" else "Separada: criticidade",Codigo_Filial_RM=Text.From([CODFILIAL]),Nome_Unidade_RM=[Nome_Unidade_RM],Codigo_Matriz_RM=[Codigo_Matriz]] in Dados,type record),
				    RegistrosGerados=Table.FromRecords(Gerar[Gerado],{"Planejamento","Unidade","Periodo_Letivo","Ano_Referencia","Identificador_Temporario","Codigo_Turma_SGE","Matriz","Status_Turma","Ativa","Codigo_Matriz_Snapshot","Nome_Curso_Snapshot","Area_Snapshot","Modalidade_Snapshot","Tipo_Mediacao_Snapshot","Carga_Horaria_Snapshot","Data_Snapshot_Matriz","Data_Inicio_Prevista","Data_Fim_Prevista","Quantidade_Vagas","Matriculas_Previstas","Campus_Polo","Financiamento","Tipo_Periodo","Pedagogo_Responsavel","Mobilizacao","Empresa","Projeto","Sindicato","Classe_Valor","Item_Contabil_Snapshot","Centro_Custo_Snapshot","Observacoes","Motivo_Cancelamento","Data_Cancelamento","Cancelada_Por","Data_Conclusao","Bloqueada_Para_Edicao","Versao_Planejamento","Origem_Registro","Data_Ultima_Revisao","Turno","Tipo_Calculo_Evasao","Percentual_Evasao_Previsto","Quantidade_Evasao_Prevista","Matriculas_Consideradas","Matriculas_Reais","Matriculas_Reais_Confirmadas","Código da turma SGE","Local_realizacao","Instrutor","Codigo_Matriz_Excel","Modalidade","Pendencias_Carga","Situacao_Carga","Codigo_Filial_RM","Nome_Unidade_RM","Codigo_Matriz_RM"},MissingField.UseNull),
				    Registros=Table.Buffer(RegistrosGerados),
				    CIds=Table.Group(Registros,{"Identificador_Temporario"},{{"N_ID",each Table.RowCount(_),Int64.Type}}),
				    ICIds=Indexar(CIds,{"Identificador_Temporario"}),
				    IIDsExistentes=Indexar(Table.SelectRows(Existentes,each [Identificador_Temporario]<>""),{"Identificador_Temporario"}),
				    V=Table.AddColumn(Registros,"Ajustado",each let R=_,C=Record.FieldOrDefault(ICIds,Chave({R[Identificador_Temporario]}),Table.FirstN(CIds,0)),D=Table.RowCount(C)=1 and C{0}[N_ID]>1,E=R[Situacao_Carga]<>"Já existente na lista enviada" and Record.HasFields(IIDsExistentes,Chave({R[Identificador_Temporario]})) in if D or E then Record.TransformFields(R,{{"Pendencias_Carga",each (if _="" then "" else _ & "; ") & "Identificador repetido"},{"Situacao_Carga",each "Separada: criticidade"}}) else R,type record),
				    Resultado=Table.FromRecords(V[Ajustado])
				in Resultado

	annotation PBI_ResultType = Table
