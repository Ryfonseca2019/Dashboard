table 'Estrutura_Vinculos_Academicos'

	column 'Esquema'
		dataType: string
		summarizeBy: none
		sourceColumn: Esquema

	column 'Tabela'
		dataType: string
		summarizeBy: none
		sourceColumn: Tabela

	column 'Coluna'
		dataType: string
		summarizeBy: none
		sourceColumn: Coluna

	column 'Tipo'
		dataType: string
		summarizeBy: none
		sourceColumn: Tipo

	partition 'Estrutura_Vinculos_Academicos' = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("SRVSEDE01621PRE", "CorporeRM", [Query="SELECT S.name AS Esquema,T.name AS Tabela,C.name AS Coluna,TY.name AS Tipo FROM sys.tables T JOIN sys.schemas S ON S.schema_id=T.schema_id JOIN sys.columns C ON C.object_id=T.object_id JOIN sys.types TY ON TY.user_type_id=C.user_type_id WHERE S.name='dbo' AND T.name IN ('SHABILITACAOFILIALPL','SPLETIVO','SEVENTOACAD') ORDER BY T.name,C.column_id"])
				in
				    Fonte

	annotation PBI_ResultType = Table
