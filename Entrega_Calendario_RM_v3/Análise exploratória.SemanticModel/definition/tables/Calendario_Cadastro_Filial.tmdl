table 'Calendario_Cadastro_Filial'

	column 'Coligada'
		dataType: string
		summarizeBy: none
		sourceColumn: Coligada

	column 'Filial'
		dataType: string
		summarizeBy: none
		sourceColumn: Filial

	column 'Nome_Filial'
		dataType: string
		summarizeBy: none
		sourceColumn: Nome_Filial

	column 'Codigo_Calendario'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Calendario

	partition 'Calendario_Cadastro_Filial' = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("SRVSEDE01621PRE", "CorporeRM", [Query="SELECT CONVERT(varchar(20),CODCOLIGADA) AS Coligada,CONVERT(varchar(20),CODFILIAL) AS Filial,NOME AS Nome_Filial,CODCALENDARIO AS Codigo_Calendario FROM dbo.GFILIAL WHERE CODCOLIGADA=3"])
				in
				    Fonte

	annotation PBI_ResultType = Table
