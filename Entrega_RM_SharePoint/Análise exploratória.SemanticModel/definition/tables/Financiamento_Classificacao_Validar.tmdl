table 'Financiamento_Classificacao_Validar'

	column 'RM_CLASSIFICACAO'
		dataType: string
		summarizeBy: none
		sourceColumn: RM_CLASSIFICACAO

	column 'Quantidade_Turmas'
		dataType: int64
		summarizeBy: none
		sourceColumn: Quantidade_Turmas

	column 'Ocorrencias_Dominio'
		dataType: int64
		summarizeBy: none
		sourceColumn: Ocorrencias_Dominio

	column 'Descricao_CLASSIFTUR'
		dataType: string
		summarizeBy: none
		sourceColumn: Descricao_CLASSIFTUR

	column 'Aplicacao_Dominio'
		dataType: string
		summarizeBy: none
		sourceColumn: Aplicacao_Dominio

	column 'Financiamento_Proposto'
		dataType: string
		summarizeBy: none
		sourceColumn: Financiamento_Proposto

	column 'Status_Validacao'
		dataType: string
		summarizeBy: none
		sourceColumn: Status_Validacao

	partition 'Financiamento_Classificacao_Validar' = m
		mode: import
		source =
				let
				    Fonte=Sql.Database("SRVSEDE01621PRE","CorporeRM",[Query="-- Resumo independente de outras consultas Power Query.#(lf)-- Somente leitura; mesma seleção SENAI e término previsto no ano atual em diante.#(lf)WITH Turmas AS (#(lf)    SELECT DISTINCT CODCOLIGADA,CODFILIAL,IDPERLET,CODTURMA#(lf)    FROM dbo.STURMA#(lf)    WHERE CODCOLIGADA=3 AND DTFINAL>=DATEFROMPARTS(YEAR(GETDATE()),1,1)#(lf)), Classificacoes AS (#(lf)    SELECT DISTINCT T.CODCOLIGADA,T.CODFILIAL,T.IDPERLET,T.CODTURMA,#(lf)        NULLIF(LTRIM(RTRIM(CONVERT(nvarchar(4000),C.CLASSIFICACAO))),N'') AS Codigo#(lf)    FROM Turmas T#(lf)    LEFT JOIN dbo.STURMACOMPL C ON C.CODCOLIGADA=T.CODCOLIGADA#(lf)        AND C.CODFILIAL=T.CODFILIAL AND C.IDPERLET=T.IDPERLET AND C.CODTURMA=T.CODTURMA#(lf)), Resumo AS (#(lf)    SELECT Codigo,COUNT_BIG(*) AS Quantidade_Turmas#(lf)    FROM Classificacoes GROUP BY Codigo#(lf)), Dominio AS (#(lf)    SELECT CONVERT(nvarchar(4000),CODCLIENTE) AS Codigo,COUNT(*) AS N,#(lf)        CASE WHEN COUNT(*)=1 THEN MAX(CONVERT(nvarchar(4000),DESCRICAO)) END Descricao#(lf)    FROM dbo.GCONSIST#(lf)    WHERE CODCOLIGADA=0 AND APLICACAO='S' AND CODTABELA='CLASSIFTUR'#(lf)    GROUP BY CONVERT(nvarchar(4000),CODCLIENTE)#(lf))#(lf)SELECT R.Codigo AS RM_CLASSIFICACAO,R.Quantidade_Turmas,#(lf)    COALESCE(D.N,0) AS Ocorrencias_Dominio,D.Descricao AS Descricao_CLASSIFTUR,#(lf)    CASE WHEN D.N=1 THEN N'S' END AS Aplicacao_Dominio,#(lf)    CASE R.Codigo WHEN N'1' THEN N'Gratuidade' WHEN N'2' THEN N'Negócio' WHEN N'3' THEN N'Negócio' END AS Financiamento_Proposto,#(lf)    CASE WHEN R.Codigo IS NULL THEN N'Sem classificação na turma'#(lf)        WHEN R.Codigo NOT IN (N'1',N'2',N'3') THEN N'Classificação sem regra aprovada'#(lf)        WHEN COALESCE(D.N,0)<>1 THEN N'Domínio ausente ou ambíguo'#(lf)        WHEN (R.Codigo=N'1' AND D.Descricao<>N'GRATUITO')#(lf)          OR (R.Codigo=N'2' AND D.Descricao<>N'NEGOCIO')#(lf)          OR (R.Codigo=N'3' AND D.Descricao<>N'NEGOCIO PJ') THEN N'Descrição do domínio mudou; revisar'#(lf)        ELSE N'Regra de migração confirmada; opção atual do app validada no de/para de produção'#(lf)    END AS Status_Validacao#(lf)FROM Resumo R LEFT JOIN Dominio D ON D.Codigo=R.Codigo;#(lf)"])
				in Fonte

	annotation PBI_ResultType = Table
