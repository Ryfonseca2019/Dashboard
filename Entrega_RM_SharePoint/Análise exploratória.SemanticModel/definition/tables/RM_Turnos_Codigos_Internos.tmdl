table 'RM_Turnos_Codigos_Internos'

	column 'CODCOLIGADA'
		dataType: int64
		summarizeBy: none
		sourceColumn: CODCOLIGADA

	column 'APLICACAO'
		dataType: string
		summarizeBy: none
		sourceColumn: APLICACAO

	column 'Codigo_Tabela'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Tabela

	column 'Codigo_Cliente'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Cliente

	column 'Codigo_Interno'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Interno

	column 'Descricao'
		dataType: string
		summarizeBy: none
		sourceColumn: Descricao

	partition 'RM_Turnos_Codigos_Internos' = m
		mode: import
		source =
				let Fonte=Sql.Database("SRVSEDE01621PRE","CorporeRM",[Query="SELECT CODCOLIGADA,CONVERT(nvarchar(100),APLICACAO) APLICACAO,#(lf)CONVERT(nvarchar(4000),CODTABELA) Codigo_Tabela,#(lf)CONVERT(nvarchar(4000),CODCLIENTE) Codigo_Cliente,#(lf)CONVERT(nvarchar(4000),CODINTERNO) Codigo_Interno,#(lf)CONVERT(nvarchar(4000),DESCRICAO) Descricao#(lf)FROM dbo.GCONSIST WHERE CODCOLIGADA IN(0,3) AND (#(lf)CONVERT(nvarchar(4000),CODTABELA) COLLATE Latin1_General_CI_AI LIKE '%TURNO%'#(lf)OR LTRIM(RTRIM(CONVERT(nvarchar(4000),DESCRICAO))) COLLATE Latin1_General_CI_AI IN ('MANHA','TARDE','NOITE','INTEGRAL','MATUTINO','VESPERTINO','NOTURNO'))#(lf)ORDER BY CODCOLIGADA,APLICACAO,CODTABELA,CODINTERNO;"]) in Fonte

	annotation PBI_ResultType = Table
