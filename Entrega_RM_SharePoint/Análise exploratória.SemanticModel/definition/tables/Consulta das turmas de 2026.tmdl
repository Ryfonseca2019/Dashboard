table 'Consulta das turmas de 2026'
	lineageTag: cc6c319b-b0fe-40f8-9acb-689434b50159


	measure 'Total de Registros RM' = COUNTROWS('Consulta das turmas de 2026')
		formatString: #,0

	measure 'Turmas Distintas RM' =
			COUNTROWS(
			    SUMMARIZE(
			        'Consulta das turmas de 2026',
			        'Consulta das turmas de 2026'[CODCOLIGADA],
			        'Consulta das turmas de 2026'[CODFILIAL],
			        'Consulta das turmas de 2026'[IDPERLET],
			        'Consulta das turmas de 2026'[Codigo_Turma_SGE]
			    )
			)
		formatString: #,0

	measure 'Registros Duplicados RM' = [Total de Registros RM] - [Turmas Distintas RM]
		formatString: #,0

	measure 'Vagas Previstas RM' = SUM('Consulta das turmas de 2026'[Quantidade_Vagas])
		formatString: #,0

	measure 'Turmas sem Curso RM' =
			CALCULATE(
			    [Total de Registros RM],
			    ISBLANK('Consulta das turmas de 2026'[Nome_Curso_Snapshot])
			        || 'Consulta das turmas de 2026'[Nome_Curso_Snapshot] = ""
			)
		formatString: #,0

	measure 'Turmas sem Data Inicio RM' =
			CALCULATE([Total de Registros RM], ISBLANK('Consulta das turmas de 2026'[Data_Inicio_Prevista]))
		formatString: #,0

	measure 'Turmas sem Data Fim RM' =
			CALCULATE([Total de Registros RM], ISBLANK('Consulta das turmas de 2026'[Data_Fim_Prevista]))
		formatString: #,0

	measure 'Turmas com Datas Invertidas RM' =
			COUNTROWS(
			    FILTER(
			        'Consulta das turmas de 2026',
			        NOT(ISBLANK('Consulta das turmas de 2026'[Data_Inicio_Prevista]))
			            && NOT(ISBLANK('Consulta das turmas de 2026'[Data_Fim_Prevista]))
			            && 'Consulta das turmas de 2026'[Data_Fim_Prevista] < 'Consulta das turmas de 2026'[Data_Inicio_Prevista]
			    )
			)
		formatString: #,0


