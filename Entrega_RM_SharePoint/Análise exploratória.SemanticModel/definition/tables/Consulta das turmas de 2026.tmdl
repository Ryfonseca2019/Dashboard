	partition 'Consulta das turmas de 2026' = m
		mode: import
		source =
				let
				  Origem = Sql.Database("SRVSEDE01621PRE", "CorporeRM", [Query = "#(lf)SELECT TOP (200)#(lf)    -- Identificação da turma#(lf)    T.CODCOLIGADA,#(lf)    T.CODFILIAL,#(lf)    T.CODTURMA AS Codigo_Turma_SGE,#(lf)    T.NOME AS Nome_Turma,#(lf)    T.IDPERLET,#(lf)#(lf)    -- Planejamento e período letivo#(lf)    P.CODPERLET AS Periodo_Letivo,#(lf)    P.DESCRICAO AS Descricao_Periodo,#(lf)    P.DTINICIO AS Inicio_Periodo_Letivo,#(lf)    P.DTFIM AS Fim_Periodo_Letivo,#(lf)#(lf)    -- Unidade#(lf)    F.NOME AS Unidade_RM,#(lf)    F.NOMEFANTASIA AS Unidade_Fantasia,#(lf)#(lf)    -- Curso e matriz#(lf)    H.CODCURSO AS Codigo_Curso,#(lf)    C.NOME AS Nome_Curso_Snapshot,#(lf)    H.CODGRADE AS Codigo_Matriz_RM,#(lf)    H.CODHABILITACAO,#(lf)    C.CODMODALIDADECURSO,#(lf)#(lf)    -- Oferta da turma#(lf)    T.MODALIDADE AS Modalidade_RM,#(lf)    T.DTINICIAL AS Data_Inicio_Prevista,#(lf)    T.DTFINAL AS Data_Fim_Prevista,#(lf)    T.MAXALUNOS AS Quantidade_Vagas,#(lf)#(lf)    -- Localização#(lf)    T.CODCAMPUS AS Campus_Polo,#(lf)    T.CODPREDIO,#(lf)    T.CODSALA,#(lf)#(lf)    -- Informações complementares#(lf)    T.CODCCUSTO AS Centro_Custo_RM,#(lf)    T.IDITEMCONTABILPROTHEUS#(lf)        AS Item_Contabil_RM,#(lf)    T.TURMAENCERRADA,#(lf)    T.ORIGEMCRIACAO,#(lf)#(lf)    -- Controle de atualização#(lf)    T.RECCREATEDON AS Data_Criacao_RM,#(lf)    T.RECMODIFIEDON AS Data_Alteracao_RM#(lf)#(lf)FROM dbo.STURMA AS T#(lf)#(lf)INNER JOIN dbo.SPLETIVO AS P#(lf)    ON T.CODCOLIGADA = P.CODCOLIGADA#(lf)    AND T.IDPERLET = P.IDPERLET#(lf)#(lf)LEFT JOIN dbo.GFILIAL AS F#(lf)    ON T.CODCOLIGADA = F.CODCOLIGADA#(lf)    AND T.CODFILIAL = F.CODFILIAL#(lf)#(lf)LEFT JOIN dbo.SHABILITACAOFILIAL AS H#(lf)    ON T.CODCOLIGADA = H.CODCOLIGADA#(lf)    AND T.IDHABILITACAOFILIAL =#(lf)        H.IDHABILITACAOFILIAL#(lf)#(lf)LEFT JOIN dbo.SCURSO AS C#(lf)    ON H.CODCOLIGADA = C.CODCOLIGADA#(lf)    AND H.CODCURSO = C.CODCURSO#(lf)#(lf)WHERE#(lf)    (#(lf)        -- Período letivo de 2026#(lf)        (#(lf)            P.DTINICIO >= '20260101'#(lf)            AND P.DTINICIO < '20270101'#(lf)        )#(lf)#(lf)        OR#(lf)        (#(lf)            P.CODPERLET LIKE '%2026%'#(lf)        )#(lf)#(lf)        OR#(lf)        (#(lf)            P.DESCRICAO LIKE '%2026%'#(lf)        )#(lf)#(lf)        -- Turma com execução em 2026#(lf)        OR#(lf)        (#(lf)            T.DTINICIAL < '20270101'#(lf)            AND T.DTFINAL >= '20260101'#(lf)        )#(lf)    )#(lf)#(lf)ORDER BY#(lf)    F.NOME,#(lf)    P.CODPERLET,#(lf)    T.CODTURMA;#(lf)", EnableCrossDatabaseFolding = true])
				in
				  Origem

	annotation PBI_ResultType = Table

