table 'DP_Mobilizacoes_Exportacao'

	column 'Codigo_RM'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_RM

	column 'Valor_App'
		dataType: string
		summarizeBy: none
		sourceColumn: Valor_App

	partition 'DP_Mobilizacoes_Exportacao' = m
		mode: import
		source =
				let
				    Fonte=#table(type table [Codigo_RM=text,Valor_App=nullable text],{{"1","Diretoria SESI/SENAI"},{"2","Empregado/dependente Sistema FIRJAN"},{"3","Unidade de Estudos Complementares"},{"4","FabLab Projeto Estratégico"},{"5","Qualificação Setorial - Comunidade"},{"6","Qualificação Setorial - Indicação pelo Sindicato"},{"7","Edital para Comunidade"},{"8","Indicação Empresas Industriais"},{"9","Dupla Escola"},{"10","Convênio SEEDUC (Gratuidade)"},{"11","Parceria com Prefeituras"},{"12","Projeto Vira Vida"},{"13","SESI Cidadania"},{"14","Forças Armadas"},{"15","Capacitação de Profissionais de Educação"},{"16","Capacitação de Colaboradores SF Exigência Legal"},{"17","Qualificação Setorial"},{"18","Olimpiada do Conhecimento"},{"19","Banco de Interesse"},{"20","Emprega +"},{"21","Gratuidade EAD Auto Instrucionais"},{"22","Edital-Empresa"},{"23","Voucher-Prática de Curso Técnico"},{"24","Retomada - COVID"},{"25","Brasil +"},{"26","Comunidade"},{"27","Qualificação Setorial - Aperfeiçoamento"},{"28","Qualificação-CBMERJ"},{"29","Qualificação - Prefeituras"},{"30","Qualificação - Forças Armadas"},{"31","Qualificação-SEEDERI"},{"32","Qualificação - Convênios Locais"},{"33","Qualificação - SESI Cidadania"},{"34","Capacitação Institucional Sistema Firjan"},{"35","Brasil pra Elas"},{"36","Robótica e suas Modalidades"},{"37","Emprega Mais - Novo Emprego"},{"38","Contrato SEEDUC (Negócio)"},{"39","ACT Prefeitura"},{"40","ACT Prefeitura - SETRAB"},{"41","Quero Bolsa"},{"42","Convênio FAEPOL"},{"43","ACT-Fuzileiros Navais"},{"44","Autonomia e Renda"},{"45","Projeto Nissan - Agentes Públicos"},{"56","ACT-SEENEMAR - Empregos Azuis 2025"},{"57","CBIC-Aprendendo a Construir"},{"58","Convênio Fundação Bunge"},{"59","ACT SMTE-Trabalho e Renda 2025-2026-2027"},{"60","Transpetro - Projeto Caminhos para o Futuro"},{"61","ACT-ASSECAMPE"},{"62","ACT da Secretaria Municipal de Assistência Social - SMAS 2026"},{"63","ACT FAETEC 2026 (Aperfeiçoamento e QP)"},{"64","TCT FAETEC 2026 (Aperfeiçoamento e QP)"},{"65","3º edital QP Centralizado Gratuidade 2026"},{"66","ACT-Instituto Providência"},{"67","PROPAG-Concomitante"},{"68","PROPAG-Subsequente"},{"69",null},{"70","Futuro Digital"},{"72","ACT Secretaria Mulheres Macaé"},{"73","ACT Secretaria Qualificação Macaé"},{"77","Trilha de Aperfeiçoamento"},{"78","SETRAB"}}),
				    Opcoes=List.Buffer(Table.SelectRows(APP_Opcoes_Escolha,each [Campo_Interno]="Mobilizacao")[Opcao]),
				    Valida=Table.TransformColumns(Fonte,{{"Valor_App",each if _=null then null else if List.Contains(Opcoes,_) then _ else null,type nullable text}})
				in Valida

	annotation PBI_ResultType = Table
