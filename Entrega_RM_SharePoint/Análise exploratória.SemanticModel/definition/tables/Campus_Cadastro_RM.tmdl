table 'Campus_Cadastro_RM'

	column 'RM_CODCOLIGADA'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_CODCOLIGADA

	column 'RM_CODFILIAL_Cadastro'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_CODFILIAL_Cadastro

	column 'RM_Codigo_Campus'
		dataType: string
		summarizeBy: none
		sourceColumn: RM_Codigo_Campus

	column 'RM_Nome_Campus'
		dataType: string
		summarizeBy: none
		sourceColumn: RM_Nome_Campus

	column 'RM_Descricao_Campus'
		dataType: string
		summarizeBy: none
		sourceColumn: RM_Descricao_Campus

	column 'Escopo_Cadastro'
		dataType: string
		summarizeBy: none
		sourceColumn: Escopo_Cadastro

	column 'Origem_Cadastro'
		dataType: string
		summarizeBy: none
		sourceColumn: Origem_Cadastro

	column 'Status_Cadastro_RM'
		dataType: string
		summarizeBy: none
		sourceColumn: Status_Cadastro_RM

	column 'RM_Tipo_Campus'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_Tipo_Campus

	column 'RM_Campus_Ativo'
		dataType: string
		summarizeBy: none
		sourceColumn: RM_Campus_Ativo

	partition 'Campus_Cadastro_RM' = m
		mode: import
		source =
				let Fonte=Sql.Database("SRVSEDE01621PRE","CorporeRM",[Query="-- Estrutura confirmada na exportação Campus.csv: SCAMPUS não possui coligada/filial.#(lf)-- Cadastro compartilhado; o filtro SENAI é aplicado nas turmas, não nesta tabela.#(lf)SELECT#(lf)    CAST(NULL AS int) AS RM_CODCOLIGADA,#(lf)    CAST(NULL AS int) AS RM_CODFILIAL_Cadastro,#(lf)    CONVERT(nvarchar(4000), C.CODCAMPUS) AS RM_Codigo_Campus,#(lf)    CAST(NULL AS nvarchar(4000)) AS RM_Nome_Campus,#(lf)    CONVERT(nvarchar(4000), C.DESCRICAO) AS RM_Descricao_Campus,#(lf)    CONVERT(int, C.TIPOCAMPUS) AS RM_Tipo_Campus,#(lf)    CONVERT(nvarchar(100), C.ATIVO) AS RM_Campus_Ativo,#(lf)    N'Cadastro sem coligada/filial; vínculo por CODCAMPUS' AS Escopo_Cadastro,#(lf)    N'dbo.SCAMPUS' AS Origem_Cadastro,#(lf)    N'Estrutura confirmada; validar descrição e vínculo com STURMA' AS Status_Cadastro_RM#(lf)FROM dbo.SCAMPUS AS C;#(lf)"]) in Fonte

	annotation PBI_ResultType = Table
