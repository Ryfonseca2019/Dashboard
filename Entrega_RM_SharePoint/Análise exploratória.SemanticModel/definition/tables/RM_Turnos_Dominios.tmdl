table 'RM_Turnos_Dominios'

	column 'CODCOLIGADA'
		dataType: int64
		summarizeBy: none
		sourceColumn: CODCOLIGADA

	column 'APLICACAO'
		dataType: string
		summarizeBy: none
		sourceColumn: APLICACAO

	column 'Codigo_Tabela'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Tabela

	column 'Codigo_Valor'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Valor

	column 'Descricao_Valor'
		dataType: string
		summarizeBy: none
		sourceColumn: Descricao_Valor

	partition 'RM_Turnos_Dominios' = m
		mode: import
		source =
				let Fonte=Sql.Database("SRVSEDE01621PRE","CorporeRM",[Query="SELECT CODCOLIGADA, CONVERT(nvarchar(100),APLICACAO) APLICACAO,#(lf)CONVERT(nvarchar(4000),CODTABELA) Codigo_Tabela,CONVERT(nvarchar(4000),CODCLIENTE) Codigo_Valor,CONVERT(nvarchar(4000),DESCRICAO) Descricao_Valor#(lf)FROM dbo.GCONSIST WHERE CODCOLIGADA IN(0,3) AND (#(lf)CONVERT(nvarchar(4000),CODTABELA) COLLATE Latin1_General_CI_AI LIKE '%TURNO%'#(lf)OR LTRIM(RTRIM(CONVERT(nvarchar(4000),DESCRICAO))) COLLATE Latin1_General_CI_AI IN ('MANHA','TARDE','NOITE','INTEGRAL','MATUTINO','VESPERTINO','NOTURNO'))#(lf)ORDER BY CODCOLIGADA,APLICACAO,CODTABELA,CODCLIENTE;"]) in Fonte

	annotation PBI_ResultType = Table
