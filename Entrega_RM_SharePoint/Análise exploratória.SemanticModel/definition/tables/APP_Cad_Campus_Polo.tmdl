				    Fonte = SharePoint.Tables("https://sfirjan.sharepoint.com/sites/PlanejamentodeOfertasparaProduo-EP", [Implementation = "2.0", ViewMode = "All"]),
				    Itens = Fonte{[Id = "6b268d10-9767-49ab-a7bb-41846ec0705c"]}[Items],
				    Campos = Table.SelectColumns(Itens, {"ID", "Nome_Campus_Polo", "Codigo_Campus_Polo_SGE", "Ativa"}),
				    Rotulos = Table.TransformColumns(Campos, {{"Nome_Campus_Polo", Texto, type text}, {"Codigo_Campus_Polo_SGE", Texto, type text}}),
				    Tipos = Table.TransformColumnTypes(Rotulos, {{"ID", Int64.Type}, {"Ativa", type logical}}, "pt-BR")
				in
				    Tipos

	annotation PBI_ResultType = Table
