table 'RM_Mediacao_Dominios'

	column 'CODCOLIGADA'
		dataType: int64
		summarizeBy: none
		sourceColumn: CODCOLIGADA

	column 'APLICACAO'
		dataType: string
		summarizeBy: none
		sourceColumn: APLICACAO

	column 'Codigo_Tabela'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Tabela

	column 'Codigo_Valor'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Valor

	column 'Descricao_Valor'
		dataType: string
		summarizeBy: none
		sourceColumn: Descricao_Valor

	partition 'RM_Mediacao_Dominios' = m
		mode: import
		source =
				let Fonte=Sql.Database("SRVSEDE01621PRE","CorporeRM",[Query="SELECT CODCOLIGADA, CONVERT(nvarchar(100),APLICACAO) APLICACAO,#(lf)CONVERT(nvarchar(4000),CODTABELA) Codigo_Tabela,#(lf)CONVERT(nvarchar(4000),CODCLIENTE) Codigo_Valor,#(lf)CONVERT(nvarchar(4000),DESCRICAO) Descricao_Valor#(lf)FROM dbo.GCONSIST#(lf)WHERE CODCOLIGADA IN (0,3) AND (#(lf) CONVERT(nvarchar(4000),CODTABELA)='TIPOEAD'#(lf) OR CONVERT(nvarchar(4000),CODTABELA) COLLATE Latin1_General_CI_AI LIKE '%MEDI%'#(lf) OR CONVERT(nvarchar(4000),CODTABELA) COLLATE Latin1_General_CI_AI LIKE '%MODAL%'#(lf) OR CONVERT(nvarchar(4000),DESCRICAO) COLLATE Latin1_General_CI_AI LIKE '%PRESENC%'#(lf) OR CONVERT(nvarchar(4000),DESCRICAO) COLLATE Latin1_General_CI_AI LIKE '%DISTANC%'#(lf) OR CONVERT(nvarchar(4000),DESCRICAO) COLLATE Latin1_General_CI_AI LIKE '%HIBRID%'#(lf) OR CONVERT(nvarchar(4000),DESCRICAO) COLLATE Latin1_General_CI_AI LIKE '%MEDIAC%')#(lf)ORDER BY CODCOLIGADA,CODTABELA,CODCLIENTE;"]) in Fonte

	annotation PBI_ResultType = Table
