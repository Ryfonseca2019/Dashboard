table 'RM_Turnos_Cadastro_Completo'

	column 'CODCOLIGADA'
		dataType: int64
		summarizeBy: none
		sourceColumn: CODCOLIGADA

	column 'CODFILIAL'
		dataType: int64
		summarizeBy: none
		sourceColumn: CODFILIAL

	column 'CODTIPOCURSO'
		dataType: int64
		summarizeBy: none
		sourceColumn: CODTIPOCURSO

	column 'Codigo_Turno'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Turno

	column 'Nome_Turno'
		dataType: string
		summarizeBy: none
		sourceColumn: Nome_Turno

	column 'Tipo_Turno'
		dataType: string
		summarizeBy: none
		sourceColumn: Tipo_Turno

	column 'Hora_Inicio'
		dataType: string
		summarizeBy: none
		sourceColumn: Hora_Inicio

	column 'Hora_Fim'
		dataType: string
		summarizeBy: none
		sourceColumn: Hora_Fim

	partition 'RM_Turnos_Cadastro_Completo' = m
		mode: import
		source =
				let Fonte=Sql.Database("SRVSEDE01621PRE","CorporeRM",[Query="SELECT CODCOLIGADA,CODFILIAL,CODTIPOCURSO,#(lf)CONVERT(nvarchar(100),CODTURNO) Codigo_Turno,#(lf)CONVERT(nvarchar(4000),NOME) Nome_Turno,#(lf)CONVERT(nvarchar(100),TIPO) Tipo_Turno,#(lf)CONVERT(nvarchar(100),HORINI) Hora_Inicio,#(lf)CONVERT(nvarchar(100),HORFIM) Hora_Fim#(lf)FROM dbo.STURNO WHERE CODCOLIGADA=3#(lf)ORDER BY CODFILIAL,CODTIPOCURSO,CODTURNO;"]) in Fonte

	annotation PBI_ResultType = Table
