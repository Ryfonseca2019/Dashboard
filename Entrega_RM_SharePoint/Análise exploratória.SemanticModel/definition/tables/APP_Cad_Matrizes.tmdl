table 'APP_Cad_Matrizes'

	column 'ID'
		dataType: int64
		summarizeBy: none
		sourceColumn: ID

	column 'Codigo_Matriz'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Matriz

	column 'Nome_Curso'
		dataType: string
		summarizeBy: none
		sourceColumn: Nome_Curso

	column 'Area'
		dataType: string
		summarizeBy: none
		sourceColumn: Area

	column 'Modalidade'
		dataType: string
		summarizeBy: none
		sourceColumn: Modalidade

	column 'Tipo_Mediacao'
		dataType: string
		summarizeBy: none
		sourceColumn: Tipo_Mediacao

	column 'Carga_Horaria'
		dataType: double
		summarizeBy: none
		sourceColumn: Carga_Horaria
		formatString: #,0.00

	column 'Item_Contabil'
		dataType: string
		summarizeBy: none
		sourceColumn: Item_Contabil

	column 'Ativa'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Ativa

	partition 'APP_Cad_Matrizes' = m
		mode: import
		source =
				let
				    // Cópia local do CSV fornecido pelo usuário; ID 4683 excluído conforme confirmação.
				    Dados=Json.Document(Binary.Decompress(Binary.FromText("",BinaryEncoding.Base64),Compression.Deflate)),
				    Fonte=Table.FromRecords(Dados),
				    Tipos=Table.TransformColumnTypes(Fonte,{{"ID",Int64.Type},{"Codigo_Matriz",type text},{"Nome_Curso",type text},{"Area",type text},{"Modalidade",type text},{"Tipo_Mediacao",type text},{"Carga_Horaria",type number},{"Item_Contabil",type text},{"Ativa",type logical}})
				in Tipos

	annotation PBI_ResultType = Table
