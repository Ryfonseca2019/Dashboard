table 'Niteroi_PreCarga'

	column 'RM_CODCOLIGADA'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_CODCOLIGADA

	column 'RM_CODFILIAL'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_CODFILIAL

	column 'RM_IDPERLET'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_IDPERLET

	column 'RM_CODTURMA'
		dataType: string
		summarizeBy: none
		sourceColumn: RM_CODTURMA

	column 'Codigo_Turma_SGE'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Turma_SGE

	column 'Nome_Curso_Snapshot'
		dataType: string
		summarizeBy: none
		sourceColumn: Nome_Curso_Snapshot

	column 'Matriz'
		dataType: string
		summarizeBy: none
		sourceColumn: Matriz

	column 'Carga_Horaria_Snapshot'
		dataType: double
		summarizeBy: none
		sourceColumn: Carga_Horaria_Snapshot

	column 'Modalidade_Snapshot'
		dataType: string
		summarizeBy: none
		sourceColumn: Modalidade_Snapshot

	column 'Tipo_Mediacao_Snapshot'
		dataType: string
		summarizeBy: none
		sourceColumn: Tipo_Mediacao_Snapshot

	column 'Campus_Polo'
		dataType: string
		summarizeBy: none
		sourceColumn: Campus_Polo

	column 'Financiamento'
		dataType: string
		summarizeBy: none
		sourceColumn: Financiamento

	column 'ID_Financiamento_SharePoint'
		dataType: int64
		summarizeBy: none
		sourceColumn: ID_Financiamento_SharePoint

	column 'Status_Financiamento'
		dataType: string
		summarizeBy: none
		sourceColumn: Status_Financiamento

	column 'Status_Cruzamento_Matriz'
		dataType: string
		summarizeBy: none
		sourceColumn: Status_Cruzamento_Matriz

	column 'Obrigatorios_Vazios'
		dataType: string
		summarizeBy: none
		sourceColumn: Obrigatorios_Vazios

	column 'Status_PreCarga'
		dataType: string
		summarizeBy: none
		sourceColumn: Status_PreCarga

	column 'Status_Unidade_Planejamento'
		dataType: string
		summarizeBy: none
		sourceColumn: Status_Unidade_Planejamento

	column 'Identificador_Temporario'
		dataType: string
		summarizeBy: none
		sourceColumn: Identificador_Temporario

	column 'Status_Identificador'
		dataType: string
		summarizeBy: none
		sourceColumn: Status_Identificador

	column 'Modalidade'
		dataType: string
		summarizeBy: none
		sourceColumn: Modalidade

	column 'Origem_Registro'
		dataType: string
		summarizeBy: none
		sourceColumn: Origem_Registro

	partition 'Niteroi_PreCarga' = m
		mode: import
		source =
				let
				    Fonte=Table.SelectRows(Exportacao_App_Enriquecida,each [RM_CODCOLIGADA]=3 and [RM_CODFILIAL]=266),
				    Obrigatorios=List.Buffer(Table.SelectRows(APP_Contrato_Campos,each [Obrigatorio]=true and not List.Contains({"Pedagogo_Responsavel","Tipo_Calculo_Evasao"},[Campo_Interno]))[Campo_Interno]),
				    Campos=Table.AddColumn(Fonte,"Obrigatorios_Vazios",each let R=_ in Text.Combine(List.Select(Obrigatorios,(C)=>let V=Record.FieldOrDefault(R,C,null) in V=null or (Value.Is(V,type text) and Text.Trim(V)="")),"; "),type text),
				    Status=Table.AddColumn(Campos,"Status_PreCarga",each if [Obrigatorios_Vazios]<>"" then "Pendente: preencher campos ou ajustar obrigatoriedade" else if [Status_Financiamento]<>"Regra confirmada" then "Pendente: financiamento" else if [Status_Cruzamento_Matriz]<>"Matriz cruzada; validar demais campos antes da carga" then "Pendente: matriz" else "Conferência estrutural sem pendências; testar inclusão no app",type text),
				    Resultado=Table.SelectColumns(Status,{"RM_CODCOLIGADA","RM_CODFILIAL","RM_IDPERLET","RM_CODTURMA","Codigo_Turma_SGE","Nome_Curso_Snapshot","Matriz","Carga_Horaria_Snapshot","Modalidade_Snapshot","Tipo_Mediacao_Snapshot","Campus_Polo","Financiamento","ID_Financiamento_SharePoint","Status_Financiamento","Status_Cruzamento_Matriz","Obrigatorios_Vazios","Status_PreCarga","Status_Unidade_Planejamento", "Identificador_Temporario", "Status_Identificador", "Modalidade", "Origem_Registro"})
				in Resultado

	annotation PBI_ResultType = Table
