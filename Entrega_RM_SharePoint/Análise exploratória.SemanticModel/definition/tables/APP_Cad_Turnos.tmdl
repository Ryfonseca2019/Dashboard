table 'APP_Cad_Turnos'

	column 'ID'
		dataType: int64
		summarizeBy: none
		sourceColumn: ID

	column 'Nome_Turno'
		dataType: string
		summarizeBy: none
		sourceColumn: Nome_Turno

	column 'Codigo_Turno_SGE'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Turno_SGE

	column 'Ativa'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Ativa

	partition 'APP_Cad_Turnos' = m
		mode: import
		source =
				let
				    Texto = (v as any) as nullable text =>
				        if v = null then null
				        else if Value.Is(v, type record) then
				            let chaves = {"Value", "lookupValue", "LookupValue", "Title", "Email", "DisplayName"},
				                chave = List.First(List.Select(chaves, each Record.HasFields(v, _)), null)
				            in if chave = null then error "Objeto de cadastro sem rótulo reconhecido" else @Texto(Record.Field(v, chave))
				        else if Value.Is(v, type list) then Text.Combine(List.RemoveNulls(List.Transform(v, each @Texto(_))), "; ")
				        else Text.From(v, "pt-BR"),
				    Fonte = SharePoint.Tables("https://sfirjan.sharepoint.com/sites/PlanejamentodeOfertasparaProduo-EP", [Implementation = "2.0", ViewMode = "All"]),
				    Itens = Fonte{[Id = "b6a922a4-6fab-446f-aa7e-8b9082c03734"]}[Items],
				    Campos = Table.SelectColumns(Itens, {"ID", "Nome_Turno", "Codigo_Turno_SGE", "Ativa"}),
				    Rotulos = Table.TransformColumns(Campos, {{"Nome_Turno", Texto, type text}, {"Codigo_Turno_SGE", Texto, type text}}),
				    Tipos = Table.TransformColumnTypes(Rotulos, {{"ID", Int64.Type}, {"Ativa", type logical}}, "pt-BR")
				in
				    Tipos

	annotation PBI_ResultType = Table
