	partition 'Exportacao_App_Enriquecida' = m
		mode: import
		source =
				let
				    Base=RM_Integracao_SharePoint,
				    SemCampus=Table.RemoveColumns(Base,{"Campus_Polo","ID_Campus_SharePoint","Status_Campus"}),
				    CodigosCampus=Table.TransformColumns(SemCampus,{{"RM_Codigo_Campus",each if _=null then null else Text.Trim(_),type nullable text}}),
				    MapaCampus=Table.Buffer(DP_Campus_Confirmado),
				    JC=Table.NestedJoin(CodigosCampus,{"RM_Codigo_Campus"},MapaCampus,{"Codigo_RM"},"CampusValidado",JoinKind.LeftOuter),
				    Campus=Table.ExpandTableColumn(JC,"CampusValidado",{"Valor_App"},{"Campus_Polo"}),
				    SemFinanciamento=Table.RemoveColumns(Campus,{"Financiamento"}),
				    JF=Table.NestedJoin(SemFinanciamento,{"RM_CODCOLIGADA","RM_CODFILIAL","RM_IDPERLET","RM_CODTURMA"},Table.Buffer(Financiamento_Por_Turma),{"RM_CODCOLIGADA","RM_CODFILIAL","RM_IDPERLET","RM_CODTURMA"},"FinanciamentoValidado",JoinKind.LeftOuter),
				    EF=Table.ExpandTableColumn(JF,"FinanciamentoValidado",{"Financiamento","ID_Financiamento_SharePoint","Status_Financiamento"},{"Financiamento","ID_Financiamento_SharePoint","Status_Financiamento"}),
				    FinanciamentoBase=Table.TransformColumns(EF,{{"Status_Financiamento",each if _=null then "Pendente: turma sem diagnóstico de classificação" else _,type text}}),
				    SemID=Table.RemoveColumns(FinanciamentoBase,{"Identificador_Temporario"}),
				    JID=Table.NestedJoin(SemID,{"RM_CODCOLIGADA","RM_CODFILIAL","RM_IDPERLET","RM_CODTURMA"},Table.Buffer(DP_Identificadores_Niteroi),{"RM_CODCOLIGADA","RM_CODFILIAL","RM_IDPERLET","RM_CODTURMA"},"IDFixo",JoinKind.LeftOuter),
				    EID=Table.ExpandTableColumn(JID,"IDFixo",{"Identificador_Fixo","Status_Identificador"},{"Identificador_Temporario","Status_Identificador"}),
				    IDs=Table.TransformColumns(EID,{{"Status_Identificador",each if _=null then "Pendente: turma fora do lote de identificadores fixos" else _,type text}}),
				    SemUnidadePlano=Table.RemoveColumns(IDs,{"Unidade","Planejamento","Ano_Referencia"}),
				    JUP=Table.NestedJoin(SemUnidadePlano,{"RM_CODCOLIGADA","RM_CODFILIAL","RM_Unidade_Nome"},Table.Buffer(DP_Unidade_Planejamento),{"RM_CODCOLIGADA","RM_CODFILIAL","RM_Unidade_Nome"},"UnidadePlano",JoinKind.LeftOuter),
				    EUP=Table.ExpandTableColumn(JUP,"UnidadePlano",{"Unidade_App","Planejamento_App","ID_Unidade_SharePoint","ID_Planejamento_SharePoint","Status_Unidade_Planejamento"},{"Unidade","Planejamento","ID_Unidade_SharePoint","ID_Planejamento_SharePoint","Status_Unidade_Planejamento"}),
				    Ano=Table.AddColumn(EUP,"Ano_Referencia",each if [Data_Inicio_Prevista]=null then null else Date.Year(Date.From([Data_Inicio_Prevista])),Int64.Type),
				    RM=Table.TransformColumns(Ano,{{"Status_Turma",each "Rascunho",type text},{"Ativa",each true,type logical},{"Bloqueada_Para_Edicao",each false,type logical},{"Versao_Planejamento",each 1,Int64.Type},{"Origem_Registro",each if OrigemImportacaoPermitida then "Importação" else null,type text}}),
				    MapaOferta=Table.Buffer(DP_Modalidade_Oferta),
				    OrigemImportacaoPermitida=List.Contains(Table.SelectRows(APP_Opcoes_Escolha,each [Campo_Interno]="Origem_Registro")[Opcao],"Importação"),
				    DP=Table.Buffer(DP_Matrizes_Validadas),
				    Cad=Table.Buffer(Table.SelectRows(APP_Cad_Matrizes,each [Ativa]=true)),
				    J=Table.NestedJoin(RM,{"RM_CODCOLIGADA","RM_Codigo_Curso","RM_Codigo_Grade"},DP,{"RM_CODCOLIGADA","RM_Codigo_Curso","RM_Codigo_Grade"},"DP",JoinKind.LeftOuter),
				    D=Table.ExpandTableColumn(J,"DP",{"ID_Matriz_SharePoint"},{"ID_Matriz_SharePoint"}),
				    K=Table.NestedJoin(D,{"ID_Matriz_SharePoint"},Cad,{"ID"},"Cadastro",JoinKind.LeftOuter),
				    E=Table.ExpandTableColumn(K,"Cadastro",{"ID","Codigo_Matriz","Nome_Curso","Area","Modalidade","Tipo_Mediacao","Carga_Horaria"},{"Cad_ID","Cad_Codigo","Cad_Nome","Cad_Area","Cad_Modalidade","Cad_Mediacao","Cad_Carga"}),
				    SemAntigas=Table.RemoveColumns(E,{"Matriz", "Codigo_Matriz_Snapshot", "Codigo_Matriz_Excel", "Nome_Curso_Snapshot", "Area_Snapshot", "Modalidade_Snapshot", "Tipo_Mediacao_Snapshot", "Carga_Horaria_Snapshot", "Data_Snapshot_Matriz"}),
				    Matriz=Table.AddColumn(SemAntigas,"Matriz",each [Cad_Codigo],type text),
				    Codigo=Table.AddColumn(Matriz,"Codigo_Matriz_Snapshot",each [Cad_Codigo],type text),
				    Excel=Table.AddColumn(Codigo,"Codigo_Matriz_Excel",each [Cad_Codigo],type text),
				    Curso=Table.AddColumn(Excel,"Nome_Curso_Snapshot",each [Cad_Nome],type text),
				    Area=Table.AddColumn(Curso,"Area_Snapshot",each [Cad_Area],type text),
				    Modalidade=Table.AddColumn(Area,"Modalidade_Snapshot",each [Cad_Modalidade],type text),
				    Mediacao=Table.AddColumn(Modalidade,"Tipo_Mediacao_Snapshot",each [Cad_Mediacao],type text),
				    Carga=Table.AddColumn(Mediacao,"Carga_Horaria_Snapshot",each [Cad_Carga],type number),
				    Captura=Table.AddColumn(Carga,"Data_Snapshot_Matriz",each if [Cad_ID]=null then null else DateTime.FixedLocalNow(),type datetime),
				    ModalidadeObrigatoria=Table.AddColumn(Captura,"Modalidade",each let Mediacao=[Cad_Mediacao],Op=Table.SelectRows(MapaOferta,each [Mediacao_Origem]=Mediacao) in if Table.RowCount(Op)=1 then Op{0}[Valor_App] else null,type text),
				    SegundaData=Table.AddColumn(ModalidadeObrigatoria,"Data_Snapshot_Matriz0",each [Data_Snapshot_Matriz],type datetime),
				    Conflitos=Table.Buffer(Table.SelectRows(Matrizes_Divergencias_Recebidas,each Text.Contains([Motivo],"Modalidade"))),
				    JCf=Table.NestedJoin(SegundaData,{"RM_CODCOLIGADA","RM_Codigo_Curso","RM_Codigo_Grade"},Conflitos,{"RM_CODCOLIGADA","RM_Codigo_Curso","RM_Codigo_Grade"},"Divergencias",JoinKind.LeftOuter),
				    Status=Table.AddColumn(JCf,"Status_Cruzamento_Matriz",each if Table.RowCount([Divergencias])>0 then "Pendente: divergência de modalidade nos arquivos recebidos; revisar" else if [ID_Matriz_SharePoint]=null then "Pendente: aprovar de/para de matriz" else if [Cad_ID]=null then "Pendente: ID não encontrado em matrizes ativas" else if [Cad_Modalidade]=null or [Cad_Carga]=null then "Pendente: cadastro da matriz incompleto" else if [Modalidade]=null then "Pendente: mediação sem correspondência em Modalidade de oferta" else "Matriz cruzada; validar demais campos antes da carga",type text),
				    Resultado=Table.SelectColumns(Status,{"Planejamento", "Unidade", "Periodo_Letivo", "Ano_Referencia", "Identificador_Temporario", "Codigo_Turma_SGE", "Matriz", "Status_Turma", "Ativa", "Codigo_Matriz_Snapshot", "Nome_Curso_Snapshot", "Area_Snapshot", "Modalidade_Snapshot", "Tipo_Mediacao_Snapshot", "Carga_Horaria_Snapshot", "Data_Snapshot_Matriz", "Data_Inicio_Prevista", "Data_Fim_Prevista", "Quantidade_Vagas", "Matriculas_Previstas", "Campus_Polo", "Financiamento", "Tipo_Periodo", "Pedagogo_Responsavel", "Mobilizacao", "Empresa", "Projeto", "Sindicato", "Classe_Valor", "Item_Contabil_Snapshot", "Centro_Custo_Snapshot", "Observacoes", "Motivo_Cancelamento", "Data_Cancelamento", "Cancelada_Por", "Data_Conclusao", "Bloqueada_Para_Edicao", "Versao_Planejamento", "Origem_Registro", "Data_Ultima_Revisao", "Turno", "Tipo_Calculo_Evasao", "Percentual_Evasao_Previsto", "Quantidade_Evasao_Prevista", "Matriculas_Consideradas", "ID", "Matriculas_Reais", "Matriculas_Reais_Confirmadas", "Código da turma SGE", "Local_realizacao", "Instrutor", "Codigo_Matriz_Excel", "Criado", "Criado por", "Modalidade", "Data_Snapshot_Matriz0", "ID_Matriz_SharePoint", "Status_Cruzamento_Matriz", "RM_CODCOLIGADA", "RM_CODFILIAL", "RM_IDPERLET", "RM_CODTURMA", "RM_Codigo_Curso", "RM_Codigo_Grade", "ID_Financiamento_SharePoint", "Status_Financiamento", "ID_Unidade_SharePoint", "ID_Planejamento_SharePoint", "Status_Unidade_Planejamento", "Status_Identificador"})
				in Resultado

	annotation PBI_ResultType = Table
