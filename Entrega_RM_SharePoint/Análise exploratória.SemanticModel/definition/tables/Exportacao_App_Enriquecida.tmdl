	column 'Status_Cruzamento_Matriz'
		dataType: string
		summarizeBy: none
		sourceColumn: Status_Cruzamento_Matriz

	partition 'Exportacao_App_Enriquecida' = m
		mode: import
		source =
				let
				    RM=RM_Integracao_SharePoint,
				    ModalidadesPermitidas=List.Buffer(Table.SelectRows(APP_Opcoes_Escolha,each [Campo_Interno]="Modalidade")[Opcao]),
				    DP=DP_Matrizes_Validadas,
				    Cad=Table.SelectRows(APP_Cad_Matrizes,each [Ativa]=true),
				    J=Table.NestedJoin(RM,{"RM_CODCOLIGADA","RM_Codigo_Curso","RM_Codigo_Grade"},DP,{"RM_CODCOLIGADA","RM_Codigo_Curso","RM_Codigo_Grade"},"DP",JoinKind.LeftOuter),
				    D=Table.ExpandTableColumn(J,"DP",{"ID_Matriz_SharePoint"},{"ID_Matriz_SharePoint"}),
				    K=Table.NestedJoin(D,{"ID_Matriz_SharePoint"},Cad,{"ID"},"Cadastro",JoinKind.LeftOuter),
				    E=Table.ExpandTableColumn(K,"Cadastro",{"ID","Codigo_Matriz","Nome_Curso","Area","Modalidade","Tipo_Mediacao","Carga_Horaria"},{"Cad_ID","Cad_Codigo","Cad_Nome","Cad_Area","Cad_Modalidade","Cad_Mediacao","Cad_Carga"}),
				    SemAntigas=Table.RemoveColumns(E,{"Matriz", "Codigo_Matriz_Snapshot", "Codigo_Matriz_Excel", "Nome_Curso_Snapshot", "Area_Snapshot", "Modalidade_Snapshot", "Tipo_Mediacao_Snapshot", "Carga_Horaria_Snapshot", "Data_Snapshot_Matriz"}),
				    Matriz=Table.AddColumn(SemAntigas,"Matriz",each [Cad_Codigo],type text),
				    Codigo=Table.AddColumn(Matriz,"Codigo_Matriz_Snapshot",each [Cad_Codigo],type text),
				    Excel=Table.AddColumn(Codigo,"Codigo_Matriz_Excel",each [Cad_Codigo],type text),
				    Curso=Table.AddColumn(Excel,"Nome_Curso_Snapshot",each [Cad_Nome],type text),
				    Area=Table.AddColumn(Curso,"Area_Snapshot",each [Cad_Area],type text),
				    Modalidade=Table.AddColumn(Area,"Modalidade_Snapshot",each [Cad_Modalidade],type text),
				    Mediacao=Table.AddColumn(Modalidade,"Tipo_Mediacao_Snapshot",each [Cad_Mediacao],type text),
				    Carga=Table.AddColumn(Mediacao,"Carga_Horaria_Snapshot",each [Cad_Carga],type number),
				    Captura=Table.AddColumn(Carga,"Data_Snapshot_Matriz",each if [Cad_ID]=null then null else DateTime.FixedLocalNow(),type datetime),
				    ModalidadeObrigatoria=Table.AddColumn(Captura,"Modalidade",each if List.Contains(ModalidadesPermitidas,[Cad_Modalidade]) then [Cad_Modalidade] else null,type text),
				    SegundaData=Table.AddColumn(ModalidadeObrigatoria,"Data_Snapshot_Matriz0",each [Data_Snapshot_Matriz],type datetime),
				    Status=Table.AddColumn(SegundaData,"Status_Cruzamento_Matriz",each if [ID_Matriz_SharePoint]=null then "Pendente: aprovar de/para de matriz" else if [Cad_ID]=null then "Pendente: ID não encontrado em matrizes ativas" else if [Cad_Modalidade]=null or [Cad_Mediacao]=null or [Cad_Carga]=null then "Pendente: cadastro da matriz incompleto" else if not List.Contains(ModalidadesPermitidas,[Cad_Modalidade]) then "Pendente: modalidade da matriz não existe nas opções atuais da lista" else "Matriz cruzada; validar demais campos antes da carga",type text),
				    Resultado=Table.SelectColumns(Status,{"Planejamento", "Unidade", "Periodo_Letivo", "Ano_Referencia", "Identificador_Temporario", "Codigo_Turma_SGE", "Matriz", "Status_Turma", "Ativa", "Codigo_Matriz_Snapshot", "Nome_Curso_Snapshot", "Area_Snapshot", "Modalidade_Snapshot", "Tipo_Mediacao_Snapshot", "Carga_Horaria_Snapshot", "Data_Snapshot_Matriz", "Data_Inicio_Prevista", "Data_Fim_Prevista", "Quantidade_Vagas", "Matriculas_Previstas", "Campus_Polo", "Financiamento", "Tipo_Periodo", "Pedagogo_Responsavel", "Mobilizacao", "Empresa", "Projeto", "Sindicato", "Classe_Valor", "Item_Contabil_Snapshot", "Centro_Custo_Snapshot", "Observacoes", "Motivo_Cancelamento", "Data_Cancelamento", "Cancelada_Por", "Data_Conclusao", "Bloqueada_Para_Edicao", "Versao_Planejamento", "Origem_Registro", "Data_Ultima_Revisao", "Turno", "Tipo_Calculo_Evasao", "Percentual_Evasao_Previsto", "Quantidade_Evasao_Prevista", "Matriculas_Consideradas", "ID", "Matriculas_Reais", "Matriculas_Reais_Confirmadas", "Código da turma SGE", "Local_realizacao", "Instrutor", "Codigo_Matriz_Excel", "Criado", "Criado por", "Modalidade", "Data_Snapshot_Matriz0", "ID_Matriz_SharePoint", "Status_Cruzamento_Matriz"})
				in Resultado

	annotation PBI_ResultType = Table
