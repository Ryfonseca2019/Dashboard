table 'APP_Cad_Periodos_Letivos'

	column 'ID'
		dataType: int64
		summarizeBy: none
		sourceColumn: ID

	column 'Periodo_Letivo'
		dataType: string
		summarizeBy: none
		sourceColumn: Periodo_Letivo

	column 'Unidade'
		dataType: string
		summarizeBy: none
		sourceColumn: Unidade

	column 'Ativo'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Ativo

	partition 'APP_Cad_Periodos_Letivos' = m
		mode: import
		source =
				let
				    Texto = (v as any) as nullable text =>
				        if v = null then null
				        else if Value.Is(v, type record) then
				            let chaves = {"Value", "lookupValue", "LookupValue", "Title", "Email", "DisplayName"},
				                chave = List.First(List.Select(chaves, each Record.HasFields(v, _)), null)
				            in if chave = null then error "Objeto de cadastro sem rótulo reconhecido" else @Texto(Record.Field(v, chave))
				        else if Value.Is(v, type list) then Text.Combine(List.RemoveNulls(List.Transform(v, each @Texto(_))), "; ")
				        else Text.From(v, "pt-BR"),
				    Fonte = SharePoint.Tables("https://sfirjan.sharepoint.com/sites/PlanejamentodeOfertasparaProduo-EP", [ApiVersion = 15, Implementation = "2.0", ViewMode = "All"]),
				    Itens = Fonte{[Id = "4598afdd-6877-4325-81ce-cc50c2d00921"]}[Items],
				    Campos = Table.SelectColumns(Itens, {"ID", "Periodo_Letivo", "Unidade", "Ativo"}),
				    Rotulos = Table.TransformColumns(Campos, {{"Periodo_Letivo", Texto, type text}, {"Unidade", Texto, type text}}),
				    Tipos = Table.TransformColumnTypes(Rotulos, {{"ID", Int64.Type}, {"Ativo", type logical}}, "pt-BR")
				in
				    Tipos

	annotation PBI_ResultType = Table
