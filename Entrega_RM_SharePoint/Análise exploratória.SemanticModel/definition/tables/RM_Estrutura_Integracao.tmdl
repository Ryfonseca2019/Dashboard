table 'RM_Estrutura_Integracao'

	column 'TABLE_SCHEMA'
		dataType: string
		summarizeBy: none
		sourceColumn: TABLE_SCHEMA

	column 'TABLE_NAME'
		dataType: string
		summarizeBy: none
		sourceColumn: TABLE_NAME

	column 'COLUMN_NAME'
		dataType: string
		summarizeBy: none
		sourceColumn: COLUMN_NAME

	column 'DATA_TYPE'
		dataType: string
		summarizeBy: none
		sourceColumn: DATA_TYPE

	partition 'RM_Estrutura_Integracao' = m
		mode: import
		source =
				let Fonte=Sql.Database("SRVSEDE01621PRE","CorporeRM",[Query="SELECT TABLE_SCHEMA,TABLE_NAME,COLUMN_NAME,DATA_TYPE FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME IN ('STURMA','SCURSO','SHABILITACAOFILIAL','SGRADE','STURNO','SCAMPUS','SMODALIDADECURSO','STURMACOMPL','SCURSOCOMPL','GFILIAL') ORDER BY TABLE_SCHEMA,TABLE_NAME,ORDINAL_POSITION"]) in Fonte

	annotation PBI_ResultType = Table
