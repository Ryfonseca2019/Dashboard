				    Status=Table.AddColumn(N,"Status_Validacao",each if [Ocorrencias_ID]<>1 then "Pendente: ID ausente ou duplicado no app" else if [Cad]{0}[Codigo_Matriz]<>[RM_Codigo_Grade] then "Pendente: código do cadastro mudou" else if [Cad]{0}[Ativa]<>true then "Pendente: matriz não ativa" else "Código exato e ID conferidos",type text),
				    Resultado=Table.RemoveColumns(Status,{"Cad"})
				in Resultado

	annotation PBI_ResultType = Table
