	partition Consulta = m
		mode: import
		source =
				let
				  Origem = Sql.Database("SRVSEDE01621PRE", "CorporeRM", [Query = "#(lf)SELECT#(lf)    TABLE_SCHEMA,#(lf)    TABLE_NAME,#(lf)    COLUMN_NAME,#(lf)    DATA_TYPE#(lf)FROM INFORMATION_SCHEMA.COLUMNS#(lf)WHERE TABLE_NAME IN (#(lf)    'STURMA',#(lf)    'SPLETIVO',#(lf)    'SHABILITACAOFILIAL',#(lf)    'SCURSO',#(lf)    'SMATRICPL',#(lf)    'STURMADISC',#(lf)    'SPROFESSOR',#(lf)    'SPROFESSORTURMA',#(lf)    'GFILIAL'#(lf))#(lf)ORDER BY#(lf)    TABLE_NAME,#(lf)    ORDINAL_POSITION;#(lf)", EnableCrossDatabaseFolding = true])
				in
				  Origem

	annotation PBI_ResultType = Table

