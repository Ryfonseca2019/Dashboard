	partition 'Turnos_Validar' = m
		mode: import
		source =
				let Fonte=RM_Oferta_Diagnostico, Resultado=Table.Group(Fonte,{"RM_CODCOLIGADA","RM_CODFILIAL","RM_Codigo_Turno","RM_Tipo_Curso","Ocorrencias_Turno","RM_Nome_Turno","RM_Turno_Complemento"},{{"Quantidade_Turmas",each Table.RowCount(Table.Distinct(Table.SelectColumns(_,{"RM_CODCOLIGADA","RM_CODFILIAL","RM_IDPERLET","RM_CODTURMA"}))),Int64.Type}}) in Resultado

	annotation PBI_ResultType = Table
