	column 'RM_CODFILIAL'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_CODFILIAL

	column 'RM_Codigo_Turno'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_Codigo_Turno

	column 'RM_Tipo_Curso'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_Tipo_Curso

	column 'Ocorrencias_Turno'
		dataType: int64
		summarizeBy: none
		sourceColumn: Ocorrencias_Turno

	column 'RM_Nome_Turno'
		dataType: string
		summarizeBy: none
