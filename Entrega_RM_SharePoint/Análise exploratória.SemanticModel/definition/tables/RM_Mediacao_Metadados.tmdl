table 'RM_Mediacao_Metadados'

	column 'Origem'
		dataType: string
		summarizeBy: none
		sourceColumn: Origem

	column 'Tabela'
		dataType: string
		summarizeBy: none
		sourceColumn: Tabela

	column 'Campo'
		dataType: string
		summarizeBy: none
		sourceColumn: Campo

	column 'Detalhe'
		dataType: string
		summarizeBy: none
		sourceColumn: Detalhe

	partition 'RM_Mediacao_Metadados' = m
		mode: import
		source =
				let Fonte=Sql.Database("SRVSEDE01621PRE","CorporeRM",[Query="SELECT N'Coluna' Origem, CONVERT(nvarchar(4000),TABLE_SCHEMA+'.'+TABLE_NAME) Tabela,#(lf)CONVERT(nvarchar(4000),COLUMN_NAME) Campo,CONVERT(nvarchar(4000),DATA_TYPE) Detalhe#(lf)FROM INFORMATION_SCHEMA.COLUMNS#(lf)WHERE TABLE_NAME COLLATE Latin1_General_CI_AI LIKE '%MEDIAC%'#(lf) OR COLUMN_NAME COLLATE Latin1_General_CI_AI LIKE '%MEDIAC%'#(lf)UNION ALL#(lf)SELECT N'Rotulo GCAMPOS',CONVERT(nvarchar(4000),TABELA),CONVERT(nvarchar(4000),COLUNA),CONVERT(nvarchar(4000),DESCRICAO)#(lf)FROM dbo.GCAMPOS WHERE CONVERT(nvarchar(4000),COLUNA) COLLATE Latin1_General_CI_AI LIKE '%MEDIAC%'#(lf) OR CONVERT(nvarchar(4000),DESCRICAO) COLLATE Latin1_General_CI_AI LIKE '%MEDIAC%'#(lf)UNION ALL#(lf)SELECT N'Restricao CHECK',CONVERT(nvarchar(4000),OBJECT_SCHEMA_NAME(parent_object_id)+'.'+OBJECT_NAME(parent_object_id)),CONVERT(nvarchar(4000),name),CONVERT(nvarchar(4000),definition)#(lf)FROM sys.check_constraints WHERE definition COLLATE Latin1_General_CI_AI LIKE '%MEDIAC%'#(lf)UNION ALL#(lf)SELECT N'Descricao SQL',CONVERT(nvarchar(4000),OBJECT_SCHEMA_NAME(c.object_id)+'.'+OBJECT_NAME(c.object_id)),CONVERT(nvarchar(4000),c.name),CONVERT(nvarchar(4000),ep.value)#(lf)FROM sys.columns c JOIN sys.extended_properties ep ON ep.class=1 AND ep.major_id=c.object_id AND ep.minor_id=c.column_id#(lf)WHERE c.name COLLATE Latin1_General_CI_AI LIKE '%MEDIAC%';"]) in Fonte

	annotation PBI_ResultType = Table
