table 'RM_Grade_TipoEAD'

	column 'CODCOLIGADA'
		dataType: int64
		summarizeBy: none
		sourceColumn: CODCOLIGADA

	column 'CODCURSO'
		dataType: string
		summarizeBy: none
		sourceColumn: CODCURSO

	column 'CODHABILITACAO'
		dataType: string
		summarizeBy: none
		sourceColumn: CODHABILITACAO

	column 'CODGRADE'
		dataType: string
		summarizeBy: none
		sourceColumn: CODGRADE

	column 'TIPOEAD'
		dataType: string
		summarizeBy: none
		sourceColumn: TIPOEAD

	partition 'RM_Grade_TipoEAD' = m
		mode: import
		source =
				let
				    Estrutura=Sql.Database("SRVSEDE01621PRE","CorporeRM",[Query="SELECT COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA='dbo' AND TABLE_NAME='SGRADECOMPL';"]),
				    Necessarios={"CODCOLIGADA","CODCURSO","CODHABILITACAO","CODGRADE","TIPOEAD"},
				    Faltantes=List.Difference(Necessarios,Estrutura[COLUMN_NAME]),
				    Fonte=if List.Count(Faltantes)>0 then error ("SGRADECOMPL: estrutura não confirmada ou sem visibilidade. Colunas ausentes: " & Text.Combine(Faltantes,", ")) else Sql.Database("SRVSEDE01621PRE","CorporeRM",[Query="SELECT CODCOLIGADA, CONVERT(nvarchar(100),CODCURSO) CODCURSO, CONVERT(nvarchar(100),CODHABILITACAO) CODHABILITACAO, CONVERT(nvarchar(100),CODGRADE) CODGRADE, CONVERT(nvarchar(100),TIPOEAD) TIPOEAD FROM dbo.SGRADECOMPL WHERE CODCOLIGADA=3;"])
				in Fonte

	annotation PBI_ResultType = Table
