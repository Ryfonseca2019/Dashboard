table 'Complementar_Resumo'

	column 'Situacao_Carga'
		dataType: string
		summarizeBy: none
		sourceColumn: Situacao_Carga

	column 'Quantidade_Turmas'
		dataType: int64
		summarizeBy: none
		sourceColumn: Quantidade_Turmas

	partition 'Complementar_Resumo' = m
		mode: import
		source =
				let Fonte=Complementar_Conferencia, Resultado=Table.Group(Fonte,{"Situacao_Carga"},{{"Quantidade_Turmas",each Table.RowCount(_),Int64.Type}}) in Resultado

	annotation PBI_ResultType = Table
