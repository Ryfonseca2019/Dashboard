table 'Mediacao_Por_Turma'

	column 'RM_CODCOLIGADA'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_CODCOLIGADA

	column 'RM_CODFILIAL'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_CODFILIAL

	column 'RM_IDPERLET'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_IDPERLET

	column 'RM_CODTURMA'
		dataType: string
		summarizeBy: none
		sourceColumn: RM_CODTURMA

	column 'Codigo_Mediacao_RM'
		dataType: int64
		summarizeBy: none
		sourceColumn: Codigo_Mediacao_RM

	column 'Mediacao_Turma_App'
		dataType: string
		summarizeBy: none
		sourceColumn: Mediacao_Turma_App

	column 'Status_Mediacao_Turma'
		dataType: string
		summarizeBy: none
		sourceColumn: Status_Mediacao_Turma

	partition 'Mediacao_Por_Turma' = m
		mode: import
		source =
				let
				    Fonte=Table.SelectColumns(RM_Oferta_Diagnostico,{"RM_CODCOLIGADA","RM_CODFILIAL","RM_IDPERLET","RM_CODTURMA","RM_Tipo_Mediacao"}),
				    Grupos=Table.Group(Fonte,{"RM_CODCOLIGADA","RM_CODFILIAL","RM_IDPERLET","RM_CODTURMA"},{{"Codigos",each List.Distinct([RM_Tipo_Mediacao]),type list}}),
				    Codigo=Table.AddColumn(Grupos,"Codigo_Mediacao_RM",each if List.Count([Codigos])=1 then [Codigos]{0} else null,Int64.Type),
				    Rotulo=Table.AddColumn(Codigo,"Rotulo_RM",each if [Codigo_Mediacao_RM]=1 then "PRESENCIAL" else if [Codigo_Mediacao_RM]=2 then "SEMIPRESENCIAL" else if [Codigo_Mediacao_RM]=3 then "A DISTÂNCIA" else null,type text),
				    J=Table.NestedJoin(Rotulo,{"Rotulo_RM"},Table.Buffer(DP_Modalidade_Oferta),{"Mediacao_Origem"},"Mapa",JoinKind.LeftOuter),
				    E=Table.ExpandTableColumn(J,"Mapa",{"Valor_App"},{"Mediacao_Turma_App"}),
				    Status=Table.AddColumn(E,"Status_Mediacao_Turma",each if List.Count([Codigos])<>1 then "Pendente: códigos conflitantes" else if [Codigo_Mediacao_RM]=null then "Mediação vazia no RM" else if [Rotulo_RM]=null then "Pendente: código não reconhecido" else if [Mediacao_Turma_App]=null then "Pendente: opção ausente no SharePoint" else "Mediação da turma validada",type text),
				    Resultado=Table.RemoveColumns(Status,{"Codigos","Rotulo_RM"})
				in Resultado

	annotation PBI_ResultType = Table
