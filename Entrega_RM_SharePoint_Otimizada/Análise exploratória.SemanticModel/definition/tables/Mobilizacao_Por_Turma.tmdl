table 'Mobilizacao_Por_Turma'

	column 'RM_CODCOLIGADA'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_CODCOLIGADA

	column 'RM_CODFILIAL'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_CODFILIAL

	column 'RM_IDPERLET'
		dataType: int64
		summarizeBy: none
		sourceColumn: RM_IDPERLET

	column 'RM_CODTURMA'
		dataType: string
		summarizeBy: none
		sourceColumn: RM_CODTURMA

	column 'Codigo_Mobilizacao_RM'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Mobilizacao_RM

	column 'Mobilizacao'
		dataType: string
		summarizeBy: none
		sourceColumn: Mobilizacao

	column 'Status_Mobilizacao'
		dataType: string
		summarizeBy: none
		sourceColumn: Status_Mobilizacao

	partition 'Mobilizacao_Por_Turma' = m
		mode: import
		source =
				let
				    Fonte=Table.TransformColumns(Table.SelectColumns(RM_Oferta_Diagnostico,{"RM_CODCOLIGADA","RM_CODFILIAL","RM_IDPERLET","RM_CODTURMA","RM_MOBILIZACAO"}),{{"RM_MOBILIZACAO",each if _=null then null else let T=Text.Trim(Text.From(_)) in if T="" then null else T,type nullable text}}),
				    Agrupa=Table.Group(Fonte,{"RM_CODCOLIGADA","RM_CODFILIAL","RM_IDPERLET","RM_CODTURMA"},{{"Codigos",each List.Distinct([RM_MOBILIZACAO]),type list}}),
				    Codigo=Table.AddColumn(Agrupa,"Codigo_Mobilizacao_RM",each if List.Count([Codigos])=1 then [Codigos]{0} else null,type nullable text),
				    J=Table.NestedJoin(Codigo,{"Codigo_Mobilizacao_RM"},Table.Buffer(DP_Mobilizacoes_Exportacao),{"Codigo_RM"},"Mapa",JoinKind.LeftOuter),
				    E=Table.ExpandTableColumn(J,"Mapa",{"Valor_App"},{"Mobilizacao"}),
				    Status=Table.AddColumn(E,"Status_Mobilizacao",each if List.Count([Codigos])<>1 then "Pendente: códigos conflitantes na turma" else if [Codigo_Mobilizacao_RM]=null then "Sem mobilização informada no RM" else if [Mobilizacao]=null then "Pendente: código sem de-para aprovado ou opção ausente no app" else "Mapeada para opção existente no app",type text),
				    Resultado=Table.RemoveColumns(Status,{"Codigos"})
				in Resultado

	annotation PBI_ResultType = Table
