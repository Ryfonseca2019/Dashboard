table 'RM_Dominios_Direcionados'

	column 'CODCOLIGADA'
		dataType: int64
		summarizeBy: none
		sourceColumn: CODCOLIGADA

	column 'APLICACAO'
		dataType: string
		summarizeBy: none
		sourceColumn: APLICACAO

	column 'Codigo_Tabela'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Tabela

	column 'Codigo_Valor'
		dataType: string
		summarizeBy: none
		sourceColumn: Codigo_Valor

	column 'Descricao_Valor'
		dataType: string
		summarizeBy: none
		sourceColumn: Descricao_Valor

	partition 'RM_Dominios_Direcionados' = m
		mode: import
		source =
				let Fonte=Sql.Database("SRVSEDE01621PRE","CorporeRM",[Query="SELECT CODCOLIGADA, APLICACAO,#(lf)    CONVERT(nvarchar(4000),CODTABELA) AS Codigo_Tabela,#(lf)    CONVERT(nvarchar(4000),CODCLIENTE) AS Codigo_Valor,#(lf)    CONVERT(nvarchar(4000),DESCRICAO) AS Descricao_Valor#(lf)FROM dbo.GCONSIST#(lf)WHERE (CODCOLIGADA=0 AND CODTABELA='CLASSIFTUR')#(lf)   OR (CODCOLIGADA=3 AND CODTABELA='TIPOTURNO');"]) in Fonte

	annotation PBI_ResultType = Table
